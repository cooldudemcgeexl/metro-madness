{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    // The automatic JSX runtime doesn't need React in scope.
    "react/react-in-jsx-scope": "off",
    // Only Worker#postMessage is used, which has no targetOrigin.
    "unicorn/require-post-message-target-origin": "off",
    // Sorting/reversing arrays the code just built is intentional; copying would only cost time
    // (the search sorts in its hot loop).
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["**/dist", "apps/web/public/data"],
  "overrides": [
    {
      "files": ["apps/web/scripts/**", "apps/web/vite.config.ts"],
      "env": { "browser": false, "node": true }
    },
    {
      // The routing library is meant to be read: no single-letter names (`_` marks unused).
      "files": ["packages/router/**"],
      "env": { "browser": false },
      "rules": {
        "eslint/id-length": ["error", { "min": 2, "exceptions": ["_"] }]
      }
    }
  ]
}
