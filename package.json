{
  "name": "metro-madness",
  "version": "1.0.0",
  "private": true,
  "description": "Plan the fastest run through every transit center of a system. Monorepo: the routing library and the Metro St. Louis web app.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @metro-madness/web dev",
    "build": "pnpm --filter @metro-madness/web build",
    "preview": "pnpm --filter @metro-madness/web preview",
    "data:build": "pnpm --filter @metro-madness/web data:build",
    "test:routes": "pnpm --filter @metro-madness/web test:routes",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}
